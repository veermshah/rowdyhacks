[Unit]
Description=Alamo vault Raspberry Pi hardware relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/rowdyhacks/pi
EnvironmentFile=/home/pi/rowdyhacks/pi/.env
ExecStart=/usr/bin/python3 /home/pi/rowdyhacks/pi/pi_client.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
