[Unit]
Description=Alamo vault Raspberry Pi hardware relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dhivyesh123
WorkingDirectory=/home/dhivyesh123/rowdyhacks/pi
EnvironmentFile=/home/dhivyesh123/rowdyhacks/pi/.env
ExecStart=/home/dhivyesh123/rowdyhacks/pi/.venv/bin/python /home/dhivyesh123/rowdyhacks/pi/pi_client.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
