ALAMO_SERIAL_PORT=/dev/ttyACM0
ALAMO_BAUD_RATE=9600
ALAMO_SERVER_URL=https://your-render-app.onrender.com
ALAMO_CAR_ID=solo
# Render-compatible default; use websocket only when your proxy is known to support it.
ALAMO_SOCKETIO_TRANSPORT=polling
ALAMO_JOY_SWAP_AXES=false
ALAMO_JOY_INVERT_X=true
ALAMO_JOY_INVERT_Y=true
ALAMO_TTS_COMMAND=espeak-ng
ALAMO_TTS_AUDIO_SINK=
ALAMO_JOY_CENTER_LOW=460
ALAMO_JOY_CENTER_HIGH=565
ALAMO_LIGHT_DELTA=4
ALAMO_SERVO_OPEN_ANGLE=170
ALAMO_SERVO_CLOSED_ANGLE=10
