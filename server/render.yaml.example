# Render Web Service settings (copy into the dashboard or a root render.yaml)
services:
  - type: web
    name: lootrun-server
    runtime: python
    rootDir: server
    buildCommand: pip install -r requirements.txt && python download_assets.py
    # gthread, not eventlet: gunicorn deleted its eventlet worker in 26.0.
    # gthread is gunicorn's built-in threaded worker; Flask-SocketIO falls
    # back to its "threading" async_mode (see app.py's _pick_async_mode()),
    # the same mode local `python app.py` dev already runs under.
    startCommand: gunicorn -k gthread -w 1 --threads 8 -b 0.0.0.0:$PORT app:app
    envVars:
      - key: PYTHON_VERSION
        value: 3.12.7
      - key: CORS_ORIGINS
        value: https://your-app.vercel.app,http://localhost:5173
      - key: NFC_SECRET
        sync: false
      - key: PRESAGE_API_KEY
        sync: false
