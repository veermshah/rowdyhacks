# Render Web Service settings (copy into the dashboard or a root render.yaml)
services:
  - type: web
    name: lootrun-server
    runtime: python
    rootDir: server
    buildCommand: pip install -r requirements.txt && python download_assets.py
    startCommand: gunicorn -k eventlet -w 1 -b 0.0.0.0:$PORT app:app
    envVars:
      - key: PYTHON_VERSION
        value: 3.12.7
      - key: CORS_ORIGINS
        value: https://your-app.vercel.app,http://localhost:5173
      - key: NFC_SECRET
        sync: false
      - key: PRESAGE_API_KEY
        sync: false
