    "tunnel": "cloudflared tunnel --no-autoupdate --url http://localhost:5001"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "^3.4.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
