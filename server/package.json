{
  "name": "lootrun-riverwalk-server",
  "private": true,
  "version": "2.0.0",
  "description": "Riverwalk heist checkpoint server: Socket.IO + Presage SmartSpectra face metrics",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
